{
	"manifest_version": 3,
	"name": "Usage Ledger",
	"version": "0.3.2",
	"description": "Token counter and usage history for Claude, ChatGPT & Gemini. Right tokenizer per model. Your data stays on your device.",
	"minimum_chrome_version": "114",
	"permissions": [
		"storage"
	],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_title": "Usage Ledger",
		"default_popup": "dashboard.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"content_scripts": [
		{
			"matches": [
				"https://claude.ai/*"
			],
			"js": [
				"hook.js"
			],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": [
				"https://claude.ai/*",
				"https://chatgpt.com/*",
				"https://gemini.google.com/*"
			],
			"js": [
				"core.js",
				"providers.js",
				"adapters.js",
				"content.js"
			],
			"run_at": "document_start"
		}
	],
	"optional_host_permissions": [
		"https://api.anthropic.com/*"
	]
}