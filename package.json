{
  "name": "usage-ledger",
  "version": "0.3.2",
  "private": true,
  "description": "Chrome extension: per-site, per-model token counts for Claude, ChatGPT and Gemini, plus a local usage history for claude.ai.",
  "author": "Swapnil Bhange (created with the help of Claude, by Anthropic)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swapnilbhange/usage-ledger.git"
  },
  "homepage": "https://github.com/swapnilbhange/usage-ledger#readme",
  "bugs": {
    "url": "https://github.com/swapnilbhange/usage-ledger/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "e2e": "sh e2e/gen-certs.sh && node e2e/run.js",
    "check": "node scripts/check-version.js && npm test",
    "pack": "node scripts/check-version.js && sh scripts/pack.sh",
    "store": "node store/src/inline.js && node store/build.js"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "playwright": "^1.50.0"
  },
  "engines": {
    "node": ">=20"
  }
}
